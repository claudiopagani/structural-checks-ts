{
  "name": "structural-checks-ts",
  "version": "0.2.0",
  "description": "Solver-neutral TypeScript library for structural calculations and verification workflows.",
  "license": "LGPL-2.1-or-later",
  "author": "Claudio Pagani",
  "homepage": "https://github.com/claudiopagani/structural-checks-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/claudiopagani/structural-checks-ts.git"
  },
  "bugs": {
    "url": "https://github.com/claudiopagani/structural-checks-ts/issues"
  },
  "keywords": [
    "structural-engineering",
    "civil-engineering",
    "structural-analysis",
    "masonry",
    "reinforced-concrete",
    "geotechnical-engineering",
    "eurocode",
    "ntc2018",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./applications": {
      "types": "./dist/applications/index.d.ts",
      "import": "./dist/applications/index.js",
      "default": "./dist/applications/index.js"
    },
    "./applications/*": {
      "types": "./dist/applications/*/index.d.ts",
      "import": "./dist/applications/*/index.js",
      "default": "./dist/applications/*/index.js"
    },
    "./domain/fem": {
      "types": "./dist/domain/fem/index.d.ts",
      "import": "./dist/domain/fem/index.js",
      "default": "./dist/domain/fem/index.js"
    },
    "./domain/geotechnics": {
      "types": "./dist/domain/geotechnics/index.d.ts",
      "import": "./dist/domain/geotechnics/index.js",
      "default": "./dist/domain/geotechnics/index.js"
    },
    "./domain/math": {
      "types": "./dist/domain/math/index.d.ts",
      "import": "./dist/domain/math/index.js",
      "default": "./dist/domain/math/index.js"
    },
    "./domain/terrain": {
      "types": "./dist/domain/terrain/index.d.ts",
      "import": "./dist/domain/terrain/index.js",
      "default": "./dist/domain/terrain/index.js"
    },
    "./domain/strut-and-tie": {
      "types": "./dist/domain/strut-and-tie/index.d.ts",
      "import": "./dist/domain/strut-and-tie/index.js",
      "default": "./dist/domain/strut-and-tie/index.js"
    },
    "./catalogs/soil-types": {
      "types": "./dist/catalogs/soil-types.d.ts",
      "import": "./dist/catalogs/soil-types.js",
      "default": "./dist/catalogs/soil-types.js"
    },
    "./catalogs/wall-interface-types": {
      "types": "./dist/catalogs/wall-interface-types.d.ts",
      "import": "./dist/catalogs/wall-interface-types.js",
      "default": "./dist/catalogs/wall-interface-types.js"
    },
    "./catalogs/steel-profiles": {
      "types": "./dist/catalogs/steel-profiles.d.ts",
      "import": "./dist/catalogs/steel-profiles.js",
      "default": "./dist/catalogs/steel-profiles.js"
    },
    "./norms/en1992": {
      "types": "./dist/norms/en1992/index.d.ts",
      "import": "./dist/norms/en1992/index.js",
      "default": "./dist/norms/en1992/index.js"
    },
    "./norms/italian-historical": {
      "types": "./dist/norms/italian-historical/index.d.ts",
      "import": "./dist/norms/italian-historical/index.js",
      "default": "./dist/norms/italian-historical/index.js"
    },
    "./norms/ntc2018": {
      "types": "./dist/norms/ntc2018/index.d.ts",
      "import": "./dist/norms/ntc2018/index.js",
      "default": "./dist/norms/ntc2018/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "docs/licensing.md"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node --experimental-strip-types scripts/build.ts",
    "prepack": "npm run build",
    "test": "npm run build && npm run test:run",
    "test:run": "node --experimental-strip-types scripts/run-tests.ts --suite canonical",
    "test:legacy-parity": "node --experimental-strip-types scripts/run-tests.ts --suite legacy-parity",
    "test:all": "node --experimental-strip-types scripts/run-tests.ts --suite all",
    "lint": "eslint src tests scripts eslint.config.mjs prettier.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:architecture": "node --experimental-strip-types scripts/check-architecture.ts",
    "check:normative-references": "node --experimental-strip-types scripts/check-normative-references.ts",
    "check:package": "node --experimental-strip-types scripts/check-package.ts",
    "check:packed-consumer": "node --experimental-strip-types scripts/check-packed-package-consumer.ts",
    "check:provenance": "node --experimental-strip-types scripts/check-provenance.ts",
    "check:worker-bundle": "node --experimental-strip-types scripts/check-worker-bundle.ts",
    "check:encoding": "node --experimental-strip-types scripts/check-encoding.ts",
    "check:parity-inventory": "node --experimental-strip-types scripts/check-parity-inventory.ts",
    "benchmark:masonry-arches": "npm run build && node --experimental-strip-types scripts/benchmark-masonry-arches.ts",
    "benchmark:masonry-arches:write": "npm run build && node --experimental-strip-types scripts/benchmark-masonry-arches.ts --full --write-evidence",
    "release:verify": "npm run build && npm run format:check && npm run lint && npm run typecheck && npm run test:run && npm run check:architecture && npm run check:normative-references && npm run check:provenance && npm run check:parity-inventory && npm run check:package && npm run check:packed-consumer && npm run check:worker-bundle && npm run check:encoding && npm run benchmark:masonry-arches",
    "check": "npm run release:verify"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "globals": "17.7.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
