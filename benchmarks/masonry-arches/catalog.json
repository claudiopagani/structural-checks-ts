  "provenancePolicy": {
    "rule": "Every quantitative value carries its own provenance: source, location (table/figure/section/page), reading kind, and unit. Missing values are recorded as null with kind 'unknown', never guessed.",
    "readingKinds": {
      "exact": "read directly from the full text (body text or table).",
      "digitized": "read from a figure by digitization with a measured tolerance recorded in a dataset sidecar.",
      "approximate-digitized": "read from a figure without measured tolerance; a stated estimated tolerance is mandatory.",
      "derived": "computed by this corpus from exact values; the formula is stated in the value notes.",
      "quoted": "taken from a secondary source that quotes the primary paper; both the primary and the quoting location are recorded and re-verification against the primary is required before acceptance use.",
      "stated-range": "the paper states a range; endpoints are recorded where available.",
      "unknown": "the datum was not found in the accessible record; value is null with an explanatory note."
    },
    "prohibitions": [
      "No value may be inferred from qualitative text.",
      "No value may be taken from a secondary paper without recording both the secondary and primary provenance.",
      "No copyrighted figures, page scans, or full paper copies are stored in this repository; only extracted numerical data, metadata, bibliographic references, and this corpus' own elaborations.",
      "Digitized datasets must ship with a dataset sidecar carrying provenance and estimated tolerance."
    ]
  },
  "tierDefinitions": {
    "A": {
      "label": "Direct quantitative",
      "meaning": "The structural-checks-ts masonry-arch model can directly represent geometry, loading, materials, and reinforcement of the test; direct quantitative comparison of capacity, mechanism, and failure mode."
    },
    "B": {
      "label": "Partial quantitative",
      "meaning": "Quantitative comparison is possible but known differences exist: deformable piers, backfill interaction, anchorage details, complex bond behavior, pre-damage, secondary-quoted data, etc."
    },
    "C": {
      "label": "Qualitative / mechanism",
      "meaning": "The model cannot represent the test closely enough for a direct load comparison; useful for mechanism, hinge position, reinforcement activation, URM-vs-strengthened variation, and failure mode."
    }
  },
